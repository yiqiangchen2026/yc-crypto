{
  "name": "yc-stock-monitor",
  "main": "entry.mjs",
  "compatibility_date": "2026-10-06",
  "account_id": "1e48e927816f1c260c9085542a4f658f",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR_STATE",
        "class_name": "MonitorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "monitor-state-v1",
      "new_sqlite_classes": [
        "MonitorState"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "NOTIFIER",
      "service": "yc-volume-monitor",
      "entrypoint": "StockNotifier"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "consumers": [
      {
        "queue": "yc-stock-scan",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0,
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "XLAYER_VOLUME_ENABLED": "true",
    "SITE_ORIGIN": "https://yc-crypto.pages.dev",
    "STATE_STORAGE": "durable-object",
    "USDG_SCAN_ENABLED": "true",
    "USDG_QUOTE_USDC": "5000",
    "USDG_ALERT_EDGE": "0.0001",
    "SCAN_ENABLED": "true",
    "XSTOCK_PUBLIC_ALERTS_ENABLED": "false",
    "XSTOCK_QUOTE_USD": "500",
    "XSTOCK_ROUGH_DISCOUNT": "0.01",
    "XSTOCK_ALERT_DISCOUNT": "0.02",
    "XSTOCK_ALERT_RESET_DISCOUNT": "0.018",
    "XSTOCK_CONFIRMATIONS": "2",
    "XSTOCK_CONFIRMATION_SECONDS": "180",
    "XSTOCK_ALERT_COOLDOWN_MINUTES": "90"
  }
}
